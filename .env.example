# =============================================
# 考试排考系统 - 环境变量配置文件
#
# 使用方式：
#   1. 复制为 .env：cp .env.example .env
#   2. 根据实际环境修改下方配置
#   3. Docker Compose 会自动从此文件读取（via env_file）
#   4. 本地开发时确保环境变量已设置或 .env 存在
# =============================================

# --------------------------------------------
# PostgreSQL 数据库配置
# --------------------------------------------
# 数据库用户名
POSTGRES_USER=scheduler

# 数据库密码（请替换为强密码）
POSTGRES_PASSWORD=your-secure-password-here

# 数据库名称
POSTGRES_DB=exam_scheduler

# 异步连接URL（用于FastAPI应用）
SCHEDULER_DATABASE_URL=postgresql+asyncpg://scheduler:your-secure-password-here@localhost:5432/exam_scheduler

# 同步连接URL（用于Alembic数据库迁移）
SCHEDULER_DATABASE_SYNC_URL=postgresql://scheduler:your-secure-password-here@localhost:5432/exam_scheduler

# Docker 容器内连接（docker-compose 使用）
# 注意：Docker 网络中 host 为 "db"（服务名），非 localhost
SCHEDULER_DATABASE_URL=postgresql+asyncpg://scheduler:your-secure-password-here@db:5432/exam_scheduler
SCHEDULER_DATABASE_SYNC_URL=postgresql://scheduler:your-secure-password-here@db:5432/exam_scheduler

# 数据库连接池配置
SCHEDULER_DB_POOL_SIZE=10
SCHEDULER_DB_MAX_OVERFLOW=20
SCHEDULER_DB_POOL_TIMEOUT=30

# --------------------------------------------
# 应用配置
# --------------------------------------------
# 调试模式（生产环境必须设为false）
SCHEDULER_DEBUG=false

# 应用密钥（用于JWT签名等，生产环境请替换为强密码）
SCHEDULER_SECRET_KEY=your-secret-key-here-change-in-production

# 应用主机和端口
SCHEDULER_HOST=0.0.0.0
SCHEDULER_PORT=8000

# 日志级别（DEBUG/INFO/WARNING/ERROR）
SCHEDULER_LOG_LEVEL=INFO

# --------------------------------------------
# 排考引擎配置
# --------------------------------------------
# 最大求解时间（秒）
SCHEDULER_MAX_SOLVE_TIME=300

# 最小化教室使用目标权重（0-100）
SCHEDULER_WEIGHT_ROOM_USAGE=80

# 教师负荷均衡权重（0-100）
SCHEDULER_WEIGHT_TEACHER_LOAD=90

# 学生时间分布权重（0-100）
SCHEDULER_WEIGHT_STUDENT_SPREAD=70

# 是否启用教室容量匹配优化
SCHEDULER_OPTIMIZE_CAPACITY=true

# --------------------------------------------
# 安全配置
# --------------------------------------------
# CORS允许的源（逗号分隔，*表示允许所有）
SCHEDULER_CORS_ORIGINS=*

# API访问令牌过期时间（分钟）
SCHEDULER_ACCESS_TOKEN_EXPIRE=480

# --------------------------------------------
# 备份配置（可选）
# --------------------------------------------
# 自动备份间隔（小时）
SCHEDULER_BACKUP_INTERVAL=24

# 备份保留天数
SCHEDULER_BACKUP_RETENTION=7
