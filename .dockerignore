# =============================================
# Docker 构建忽略文件
# 以下文件/目录不会进入Docker构建上下文
# =============================================

# Python 缓存
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# 虚拟环境
.venv/
venv/
env/
ENV/

# Git
.git/
.gitignore
.gitattributes

# 测试和覆盖率
.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.dmypy.json

# IDE 和编辑器
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# 文档（构建时已不需要）
docs/
*.md

# Docker 自身
docker-compose*.yml
Dockerfile*
.dockerignore

# 数据卷和日志（运行时生成）
postgres_data/
*.log
logs/

# 环境变量文件（安全考虑）
.env
.env.*
!.env.example

# 其他
*.sqlite3
*.db
node_modules/
